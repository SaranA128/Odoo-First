<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_template_only_form_view_inherit" model="ir.ui.view">
            <field name="name">stock.quant.tree.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//form//sheet" position="before">
                    <header>
                        <field name="hide_bulk_creation" invisible="1"/>
                        <button string="Backdate" name="open_backdate_wizard" type="object" class="oe_highlight"/>
                        <button string="Bulk Serial Creation" name="open_bulk_serial_create_wizard" type="object"
                                class="oe_highlight"
                                invisible="hide_bulk_creation == True"/>
                        <!--            attrs="{'invisible':[('hide_bulk_creation','=',True)]}"-->
                    </header>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

