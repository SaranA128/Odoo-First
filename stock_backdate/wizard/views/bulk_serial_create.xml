<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bulk_serial_create_form" model="ir.ui.view">
        <field name="name">bulk.serial.create.wizard.form</field>
        <field name="model">bulk.serial.create.wizard</field>
        <field name="mode">primary</field>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <form string="Bulk Serial Create Form">
                <div class="oe_title">
                    <label for='product_id'/>
                    <h1 class="d-flex">
                        <field name="product_id"/>
                    </h1>
                </div>
                <group>
                    <group>
                        <field name="hide_footer" invisible="1"/>
                        <field name="file_processed" invisible="1"/>
                        <field name="file" filename="filename" readonly="hide_footer == True"/>
                        <field name="total_serials_uploaded"/>
                        <field name="total_created" invisible="not hide_footer" string="Total Created"/>
                    </group>
                    <group>
                        <!-- <field name="increments" attrs="{'invisible': [('hide_footer','=',True)]}" /> -->
                        <field name="total_to_create" invisible="not hide_footer"/>
                        <field name="total_existing" invisible="file_processed or hide_footer"/>
                        <field name="total_duplicate_serials" invisible="not file_processed or hide_footer"/>

                        <field name="total_serials_before_creation" invisible="not hide_footer"/>
                        <field name="total_serials_after_creation" invisible="not hide_footer"/>
                    </group>
                </group>
                <div invisible="hide_footer" class="text-warning">
                    <i>NB: The sheet with serial numbers in the excel file should be named as "New Serial Numbers"</i>
                </div>
                <notebook>

                    <page string="Created Serials" invisible="not hide_footer">
                        <field name="serials_to_add" readonly="1">
                            <list editable="bottom">
                                <field name="name" required="1"/>
                                <field name="lot_in_system"/>
                            </list>
                        </field>
                    </page>
                    <page string="To Create" invisible="hide_footer">
                        <field name="serials_to_add" force_save="1">
                            <list editable="bottom">
                                <control>
                                    <create name="add_product_control" string="Add a serial number"/>
                                </control>
                                <field name="name" required="1"/>
                                <field name="lot_in_system"/>
                            </list>
                        </field>
                    </page>
                    <page string="Existing In system" invisible="not file_processed or hide_footer">
                        <field name="existing_serials">
                            <list create="0">
                                <field name="name" required="1"/>
                                <field name="lot_in_system"/>
                                <field name="lot_create_date"/>
                            </list>
                        </field>
                    </page>
                    <page string="Duplicates" invisible="not file_processed or hide_footer">
                        <field name="duplicate_serials">
                            <list string="Serial Numbers" create="0">
                                <field name="name" required="1"/>
                                <field name="lot_in_system"/>
                                <field name="lot_create_date"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button string="Process File" name="action_process_file" type="object" class="btn-success"
                            data-hotkey="z"
                            invisible="file_processed or hide_footer"/>
                    <button name="action_create" string="Create Serials"
                            confirm="New serials will for the above product will be created in the system. Continue?"
                            type="object" class="btn-primary"
                            data-hotkey="q" invisible="hide_footer"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"
                            invisible="hide_footer"/>
                    <button string="Close" class="btn-secondary" special="cancel" data-hotkey="z"
                            invisible="not hide_footer"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

        <!--Changed attrs to invisible-->
        <!--Changed attrs to readonly-->
        <!--Changed required="True" to required="1"-->
        <!--Changed tree to list-->
